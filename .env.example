# Backend
# SERVER_PORT: Backend HTTP listen port. Example: 8081
SERVER_PORT=8081
# SQLITE_DB_NAME: SQLite database file path. Example: db/test.db
SQLITE_DB_NAME=db/test.db

# SATELLITE_BASE_URL: Base URL of the iSHARE Satellite. Example: https://satellite.example.com
SATELLITE_BASE_URL=
# SATELLITE_EP_CREATION_ENDPOINT: Satellite ep_creation path. Example: /ep_creation
SATELLITE_EP_CREATION_ENDPOINT=/ep_creation
# SATELLITE_TOKEN_ENDPOINT: OAuth token path on the Satellite. Example: /connect/token
SATELLITE_TOKEN_ENDPOINT=/connect/token
# SATELLITE_TOKEN_SCOPE: Token scope used for Satellite calls. Example: iSHARE
SATELLITE_TOKEN_SCOPE=iSHARE
# SATELLITE_ISS: JWT issuer used for Satellite requests. Example: EU.EORI.NL000000000
SATELLITE_ISS=
# SATELLITE_AUD: JWT audience for Satellite tokens. Example: EU.EORI.NL000000000
SATELLITE_AUD=
# SATELLITE_X5C: Base64 DER certificate (x5c) for JWT header. Example: MIIC...
SATELLITE_X5C=
# SATELLITE_PRIVATE_KEY_PATH: Path to PEM private key for signing. Example: /app/keys/sat-private-key.pem
SATELLITE_PRIVATE_KEY_PATH=/app/keys/sat-private-key.pem
# SATELLITE_PRIVATE_KEY: PEM private key contents (alternative to *_PATH). Example: -----BEGIN PRIVATE KEY-----...
# SATELLITE_PRIVATE_KEY=
# SATELLITE_DEBUG: Enable Satellite request logging. Example: false
SATELLITE_DEBUG=false

# OIDC_DISABLE: Disable backend OIDC auth (dev only). Example: false
OIDC_DISABLE=false
# OIDC_ISSUER: OIDC issuer URL. Example: http://localhost:8080/realms/demo
OIDC_ISSUER=http://localhost:8080/realms/demo
# OIDC_AUDIENCE: Expected audience (backend client_id). Example: onboarding-backend
OIDC_AUDIENCE=onboarding-backend
# OIDC_JWKS_URL: JWKS endpoint (Docker uses service name). Example: http://keycloak:8080/realms/demo/protocol/openid-connect/certs
OIDC_JWKS_URL=http://keycloak:8080/realms/demo/protocol/openid-connect/certs

# REGISTRAR_ID: Registrar party ID returned in /settings. Example: EU.EORI.NL000000000
REGISTRAR_ID=
# DATASPACE_ID: Dataspace identifier. Example: NL.ishare
DATASPACE_ID=
# DATASPACE_TITLE: Dataspace display name. Example: iSHARE Demo
DATASPACE_TITLE=

# Frontend
# NEXT_PUBLIC_FRONTEND_DOMAIN: Public URL for frontend. Example: http://localhost:3000
NEXT_PUBLIC_FRONTEND_DOMAIN=http://localhost:3000
# NEXT_PUBLIC_BASE_SERVER_URL: Backend base URL used by frontend. Example: http://backend:8081 (Docker) or http://localhost:8081 (local)
NEXT_PUBLIC_BASE_SERVER_URL=http://backend:8081
# NEXT_PUBLIC_KEYCLOAK_BASE_URL: Keycloak base URL. Example: http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_KEYCLOAK_REALM: Keycloak realm name. Example: demo
NEXT_PUBLIC_KEYCLOAK_REALM=demo
# NEXT_PUBLIC_KEYCLOAK_CLIENT_ID: Keycloak client ID for frontend. Example: frontend
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=frontend
# NEXT_PUBLIC_IDP_ONLY: If true, always pass the IdP hint when logging in. Example: false
NEXT_PUBLIC_IDP_ONLY=false
# NEXT_PUBLIC_KEYCLOAK_IDP: Keycloak IdP alias for idpHint. Example: oidc
NEXT_PUBLIC_KEYCLOAK_IDP=

# NEXT_PUBLIC_ALWAYS_M2M: Force machine-to-machine onboarding flow. Example: true
NEXT_PUBLIC_ALWAYS_M2M=
# NEXT_PUBLIC_ALWAYS_EHERKENNING: Adjust ID-check flow for eHerkenning/eSeal. Example: true
NEXT_PUBLIC_ALWAYS_EHERKENNING=
# NEXT_PUBLIC_DEFAULT_ASSOCIATION_NAME: Fallback association name in header. Example: iSHARE Demo Association
NEXT_PUBLIC_DEFAULT_ASSOCIATION_NAME=
# NEXT_PUBLIC_SKIP_SETTINGS: Skip backend /settings fetch. Example: false
NEXT_PUBLIC_SKIP_SETTINGS=
# NEXT_PUBLIC_SKIP_ROLES: Skip role selection step. Example: false
NEXT_PUBLIC_SKIP_ROLES=
# NEXT_PUBLIC_ACTIVE_ROLES: Comma-separated roles to show. Example: dataconsumer,dataowner,dataprovider
NEXT_PUBLIC_ACTIVE_ROLES=dataconsumer,dataowner,dataprovider
# NEXT_PUBLIC_DEFAULT_ROLE: Default selected role. Example: dataconsumer
NEXT_PUBLIC_DEFAULT_ROLE=
# NEXT_PUBLIC_AUTO_ACCEPT_PROPOSAL: Auto-complete proposals after submit. Example: false
NEXT_PUBLIC_AUTO_ACCEPT_PROPOSAL=false
# NEXT_PUBLIC_STATIC_PARTY: Use PARTY_* values and skip registry lookup. Example: false
NEXT_PUBLIC_STATIC_PARTY=
# NEXT_PUBLIC_DISABLE_ADMIN_ROUTES: Hide admin UI and route guards. Example: false
NEXT_PUBLIC_DISABLE_ADMIN_ROUTES=false
# NEXT_PUBLIC_NO_NOTIFY: Disable Keycloak onboarding-notifications calls. Example: false
NEXT_PUBLIC_NO_NOTIFY=

# NEXT_PUBLIC_PARTY_ID: Default party ID for static party. Example: EU.EORI.NL123456789
NEXT_PUBLIC_PARTY_ID=
# NEXT_PUBLIC_PARTY_NAME: Default party name for static party. Example: Example Party
NEXT_PUBLIC_PARTY_NAME=
# NEXT_PUBLIC_PARTY_REGISTER_URL: Default register URL. Example: https://party.example.com/register
NEXT_PUBLIC_PARTY_REGISTER_URL=
# NEXT_PUBLIC_PARTY_CAPABILITIES_URL: Default capabilities URL. Example: https://party.example.com/capabilities
NEXT_PUBLIC_PARTY_CAPABILITIES_URL=

# Keycloak
# KEYCLOAK_ADMIN_USERNAME: Keycloak admin username (dev/provisioning). Example: admin
KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD: Keycloak admin password (dev/provisioning). Example: change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# OBP_ADMIN_EMAIL: Initial onboarding admin email for seeded users. Example: admin@example.com
OBP_ADMIN_EMAIL=admin@example.com
# OBP_ADMIN_PASSWORD: Initial onboarding admin password. Example: change-me
OBP_ADMIN_PASSWORD=change-me
# KEYCLOAK_DB_USERNAME: Keycloak DB username. Example: keycloak
KEYCLOAK_DB_USERNAME=keycloak
# KEYCLOAK_DB_PASSWORD: Keycloak DB password. Example: change-me
KEYCLOAK_DB_PASSWORD=change-me
# KEYCLOAK_DB_DATABASE: Keycloak DB name. Example: keycloak
KEYCLOAK_DB_DATABASE=keycloak

#Keycloak Email (SMTP) settings
# KEYCLOAK_SMTP_HOST: SMTP host for Keycloak email (realm import uses it). Example: smtp.sendgrid.net
KEYCLOAK_SMTP_HOST=
# KEYCLOAK_SMTP_PORT: SMTP port. Example: 587
KEYCLOAK_SMTP_PORT=
# KEYCLOAK_SMTP_FROM: From address for Keycloak emails. Example: admin@example.com
KEYCLOAK_SMTP_FROM=
# KEYCLOAK_SMTP_USER: SMTP username. Example: apikey
KEYCLOAK_SMTP_USER=
# KEYCLOAK_SMTP_PASS: SMTP password or API key. Example: change-me
KEYCLOAK_SMTP_PASS=

# Keycloak Identity Provider (IdP) settings
# KEYCLOAK_IDP_NAME: IdP alias in Keycloak (must match NEXT_PUBLIC_KEYCLOAK_IDP). Example: eHerkenning
KEYCLOAK_IDP_NAME=
# KEYCLOAK_IDP_CLIENT: OIDC client ID registered at the IdP. Example: onboarding-portal
KEYCLOAK_IDP_CLIENT=
# KEYCLOAK_IDP_SECRET: OIDC client secret registered at the IdP. Example: change-me
KEYCLOAK_IDP_SECRET=
# EH_CHAIN_PEM: Optional TLS chain for IdP trust (PEM). Example: -----BEGIN CERTIFICATE-----...
EH_CHAIN_PEM=

# Images (docker-compose.prod.yml)
# GHCR_OWNER: GHCR org/user for image pulls. Example: isharescheme
GHCR_OWNER=
# IMAGE_TAG: Image tag to pull. Example: v1.0.0
IMAGE_TAG=latest

# nginx-proxy (optional)
# FRONTEND_VIRTUAL_HOST: Public hostname for frontend. Example: portal.example.com
FRONTEND_VIRTUAL_HOST=portal.example.com
# BACKEND_VIRTUAL_HOST: Public hostname for backend API. Example: api.example.com
BACKEND_VIRTUAL_HOST=api.example.com
# KEYCLOAK_VIRTUAL_HOST: Public hostname for Keycloak. Example: auth.example.com
KEYCLOAK_VIRTUAL_HOST=auth.example.com
# LETSENCRYPT_EMAIL: Email for Let's Encrypt certs. Example: admin@example.com
LETSENCRYPT_EMAIL=admin@example.com
