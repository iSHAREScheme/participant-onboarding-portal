# Shared
RBAC_HEADER_NAME=X-RBAC-Token

# Backend
SERVER_PORT=8081
SQLITE_DB_NAME=db/test.db

SATELLITE_BASE_URL=
SATELLITE_EP_CREATION_ENDPOINT=/ep_creation
SATELLITE_TOKEN_ENDPOINT=/connect/token
SATELLITE_TOKEN_SCOPE=iSHARE
SATELLITE_ISS=
SATELLITE_AUD=
SATELLITE_X5C=
SATELLITE_PRIVATE_KEY_PATH=/app/keys/dil-sat-private-key.pem
# SATELLITE_PRIVATE_KEY=
SATELLITE_DEBUG=false

OIDC_DISABLE=false
OIDC_ISSUER=http://localhost:8080/realms/demo
OIDC_AUDIENCE=onboarding-backend
# For Docker Compose, use the service name so the backend container can reach Keycloak.
OIDC_JWKS_URL=http://keycloak:8080/realms/demo/protocol/openid-connect/certs

REGISTRAR_ID=
DATASPACE_ID=
DATASPACE_TITLE=

AUTH_PUBLIC_KEY_PATH=
AUTH_ISSUER=
AUTH_AUDIENCE=
RBAC_ADMIN_TOKEN=

# Frontend
NEXT_PUBLIC_FRONTEND_DOMAIN=http://localhost:3000
# If running frontend outside Docker, use http://localhost:8081 instead.
NEXT_PUBLIC_BASE_SERVER_URL=http://backend:8081
NEXT_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=demo
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=frontend
NEXT_PUBLIC_IDP_ONLY=false
NEXT_PUBLIC_KEYCLOAK_IDP=

NEXT_PUBLIC_ALWAYS_M2M=
NEXT_PUBLIC_ALWAYS_EHERKENNING=
NEXT_PUBLIC_DEFAULT_ASSOCIATION_NAME=
NEXT_PUBLIC_SKIP_SETTINGS=
NEXT_PUBLIC_SKIP_ROLES=
NEXT_PUBLIC_ACTIVE_ROLES=dataconsumer,dataowner,dataprovider
NEXT_PUBLIC_DEFAULT_ROLE=
NEXT_PUBLIC_AUTO_ACCEPT_PROPOSAL=false
NEXT_PUBLIC_STATIC_PARTY=
NEXT_PUBLIC_DISABLE_ADMIN_ROUTES=false
NEXT_PUBLIC_NO_NOTIFY=

NEXT_PUBLIC_PARTY_ID=
NEXT_PUBLIC_PARTY_NAME=
NEXT_PUBLIC_PARTY_REGISTER_URL=
NEXT_PUBLIC_PARTY_CAPABILITIES_URL=

# Keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
OBP_ADMIN_EMAIL=admin@example.com
OBP_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_DATABASE=keycloak

# Images (docker-compose.prod.yml)
GHCR_OWNER=
IMAGE_TAG=latest

# nginx-proxy (optional)
FRONTEND_VIRTUAL_HOST=portal.example.com
BACKEND_VIRTUAL_HOST=api.example.com
KEYCLOAK_VIRTUAL_HOST=auth.example.com
LETSENCRYPT_EMAIL=admin@example.com
