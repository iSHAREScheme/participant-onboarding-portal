FRONTEND_DOMAIN=http://localhost:3000
NEXT_PUBLIC_FRONTEND_DOMAIN=http://localhost:3000
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Backend API (used by frontend + API proxy)
NEXT_PUBLIC_BASE_SERVER_URL=http://host.docker.internal:8081

# Backend OIDC (used by backend in the full-stack compose)
OIDC_DISABLE=false
OIDC_ISSUER=http://localhost:8080/realms/demo
OIDC_AUDIENCE=onboarding-backend
# For Docker Compose, use the service name so the backend container can reach Keycloak.
OIDC_JWKS_URL=http://keycloak:8080/realms/demo/protocol/openid-connect/certs

# Keycloak (local dev)
NEXT_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=demo
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=frontend
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_DATABASE=keycloak

# SMTP (optional)
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_REPLY_FROM=
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASS=

# IDP / eHerkenning (optional)
NEXT_PUBLIC_IDP_ONLY=false
NEXT_PUBLIC_KEYCLOAK_IDP=
KEYCLOAK_IDP_NAME=
KEYCLOAK_IDP_CLIENT=
KEYCLOAK_IDP_SECRET=

# Feature flags / defaults (optional)
NEXT_PUBLIC_DISABLE_ADMIN_ROUTES=false
NEXT_PUBLIC_ALWAYS_M2M=
NEXT_PUBLIC_ALWAYS_EHERKENNING=
NEXT_PUBLIC_DEFAULT_ASSOCIATION_NAME=
NEXT_PUBLIC_AUTO_ACCEPT_PROPOSAL=false
NEXT_PUBLIC_DEFAULT_ROLE=
NEXT_PUBLIC_SKIP_ROLES=0
NEXT_PUBLIC_ACTIVE_ROLES=dataconsumer,dataowner,dataprovider
NEXT_PUBLIC_NO_NOTIFY=

# Satellite / iSHARE scheme version, shared with the backend.
# Supported values:
#   2.0, 2.1.1, 2.2 -> flat party/proposal schema
#   3.0             -> claim-based participant model (/parties + claims)
SATELLITE_VERSION=2.1.1

# Deployment only (docker-compose.yml)
GHCR_OWNER=
IMAGE_TAG=latest
