    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.4.1",
    "react-simple-wysiwyg": "^3.4.1",
    "yup": "^1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
