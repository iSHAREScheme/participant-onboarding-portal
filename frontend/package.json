{
  "name": "onboarding-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "yarn@4.7.0",
  "scripts": {
    "dev": "node scripts/write-env.js && next dev",
    "build": "next build",
    "start": "node scripts/write-env.js && next start",
    "lint": "eslint .",
    "write-env": "node scripts/write-env.js",
    "docker:login": "echo $GHCR_TOKEN | docker login ghcr.io -u $GHCR_USER --password-stdin",
    "docker:build": "docker compose build",
    "docker:push": "docker compose push",
    "prepare": "husky install",
    "commitlint": "commitlint --from=HEAD~1"
  },
  "dependencies": {
    "@react-keycloak/web": "2.1.1",
    "@types/keycloak-js": "^3.4.1",
    "asn1js": "^3",
    "axios": "^1",
    "cross-spawn": "^7.0.5",
    "dompurify": "^3",
    "formidable": "^3",
    "formik": "^2",
    "keycloak-js": "^26",
    "next": "^16.2.9",
    "pkijs": "^3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.4.1",
    "react-simple-wysiwyg": "^3.4.1",
    "yup": "^1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/formidable": "^3",
    "@types/node": "17.0.35",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "typescript": "5.6.3"
  },
  "resolutions": {
    "glob": "10.5.0"
  }
}
