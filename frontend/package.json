{
  "name": "onboarding-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "yarn@4.7.0",
  "scripts": {
    "dev": "node scripts/write-env.js && next dev",
    "build": "next build",
    "start": "node scripts/write-env.js && next start",
    "lint": "next lint",
    "write-env": "node scripts/write-env.js",
    "docker:login": "echo $GHCR_TOKEN | docker login ghcr.io -u $GHCR_USER --password-stdin",
    "docker:build": "docker compose build",
    "docker:push": "docker compose push",
    "prepare": "husky install",
    "commitlint": "commitlint --from=HEAD~1"
  },
  "dependencies": {
    "@react-keycloak/web": "2.1.1",
    "@types/keycloak-js": "^3.4.1",
    "asn1js": "^3.0.6",
    "axios": "^1.11.0",
    "cross-spawn": "^7.0.5",
    "formidable": "^3.5.2",
    "formik": "^2.4.6",
    "keycloak-js": "^26.0.4",
    "next": "^14.2.32",
    "pkijs": "^3.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.4.1",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/formidable": "^3.4.5",
    "@types/node": "17.0.35",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.10",
    "husky": "^9.1.7",
    "typescript": "5.6.3"
  },
  "resolutions": {
    "glob": "10.5.0"
  }
}
